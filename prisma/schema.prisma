generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  passwordHash         String              @map("password_hash")
  nickname             String              @unique
  role                 UserRole            @default(USER)
  status               UserStatus          @default(ACTIVE)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  profileImage         String?             @map("profile_image")
  notificationsEnabled Boolean             @default(true) @map("notifications_enabled")
  hasCompletedOnboarding Boolean           @default(false) @map("has_completed_onboarding")
  onboardingCompletedAt DateTime?          @map("onboarding_completed_at")
  onboardingVersion    Int                 @default(1) @map("onboarding_version")
  createdDebates       Debate[]            @relation("DebateCreator")
  posts                Post[]
  comments             Comment[]
  selections           SelectionTarget[]
  consensuses          Consensus[]
  votes                ConsensusVote[]
  participants         DebateParticipant[]
  moderationLogs       ModerationLog[]
  definitions          Definition[]
  definitionReferences DefinitionReference[]
  receivedNotifications Notification[]     @relation("ReceivedNotifications")
  sentNotifications    Notification[]      @relation("SentNotifications")
  passwordResetTokens  PasswordResetToken[]
  reports              Report[]
  handledReports       Report[]             @relation("ReportHandler")
  sanctions            Sanction[]           @relation("SanctionedUser")
  moderatedSanctions   Sanction[]           @relation("SanctionModerator")
  sanctionAcknowledgements SanctionAcknowledgement[]
  bookmarks            DebateBookmark[]
  subscriptions        DebateSubscription[]
  debateStances        DebateUserStance[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Debate {
  id                      String              @id @default(uuid())
  creatorId               String?             @map("creator_id")
  creator                 User?               @relation("DebateCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  parentDebateId          String?             @map("parent_debate_id")
  parentDebate            Debate?             @relation("ChildDebates", fields: [parentDebateId], references: [id])
  childDebates            Debate[]            @relation("ChildDebates")
  sourceSelectionTargetId String?             @map("source_selection_target_id")
  sourceSelectionTarget   SelectionTarget?    @relation("ChildDebateSource", fields: [sourceSelectionTargetId], references: [id])
  title                   String
  description             String
  debateType              DebateType          @map("debate_type")
  status                  DebateStatus        @default(OPEN)
  closeConditionType      CloseConditionType? @map("close_condition_type")
  closeAt                 DateTime?           @map("close_at")
  closedAt                DateTime?           @map("closed_at")
  archivedAt              DateTime?           @map("archived_at")
  resultSummary           String?             @map("result_summary")
  stanceDistribution      Json?               @map("stance_distribution")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  tagMaps                 DebateTagMap[]
  participants            DebateParticipant[]
  posts                   Post[]
  comments                Comment[]
  selections              SelectionTarget[]
  consensuses             Consensus[]
  definitions             Definition[]
  definitionReferences     DefinitionReference[]
  moderationLogs          ModerationLog[]
  notifications           Notification[]
  bookmarks               DebateBookmark[]
  subscriptions           DebateSubscription[]
  userStances             DebateUserStance[]

  @@index([creatorId])
  @@index([parentDebateId])
  @@index([sourceSelectionTargetId])
  @@index([status])
  @@map("debates")
}

model DebateTag {
  id         String         @id @default(uuid())
  name       String         @unique
  createdAt  DateTime       @default(now()) @map("created_at")
  debateMaps DebateTagMap[]

  @@map("debate_tags")
}

model DebateTagMap {
  id       String    @id @default(uuid())
  debateId String    @map("debate_id")
  debate   Debate    @relation(fields: [debateId], references: [id], onDelete: Cascade)
  tagId    String    @map("tag_id")
  tag      DebateTag @relation(fields: [tagId], references: [id])

  @@unique([debateId, tagId])
  @@index([tagId])
  @@map("debate_tag_maps")
}

model DebateParticipant {
  id           String           @id @default(uuid())
  debateId     String           @map("debate_id")
  debate       Debate           @relation(fields: [debateId], references: [id], onDelete: Cascade)
  userId       String           @map("user_id")
  user         User             @relation(fields: [userId], references: [id])
  joinedAt     DateTime         @default(now()) @map("joined_at")
  lastReadAt   DateTime?        @map("last_read_at")
  roleInDebate DebateMemberRole @default(PARTICIPANT) @map("role_in_debate")

  @@unique([debateId, userId])
  @@index([userId])
  @@map("debate_participants")
}

model Post {
  id        String     @id @default(uuid())
  debateId  String     @map("debate_id")
  debate    Debate     @relation(fields: [debateId], references: [id], onDelete: Cascade)
  authorId  String     @map("author_id")
  author    User       @relation(fields: [authorId], references: [id])
  content   String
  stance    DebateStance?
  status    PostStatus @default(VISIBLE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")
  comments  Comment[]
  definitionReferences DefinitionReference[]

  @@index([debateId])
  @@index([authorId])
  @@map("posts")
}

model DebateUserStance {
  id        String       @id @default(uuid())
  debateId  String       @map("debate_id")
  debate    Debate       @relation(fields: [debateId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  stance    DebateStance
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([debateId, userId])
  @@index([userId])
  @@map("debate_user_stances")
}

model Comment {
  id              String        @id @default(uuid())
  debateId        String        @map("debate_id")
  debate          Debate        @relation(fields: [debateId], references: [id], onDelete: Cascade)
  postId          String?       @map("post_id")
  post            Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentCommentId String?       @map("parent_comment_id")
  parentComment   Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[]     @relation("CommentReplies")
  authorId        String        @map("author_id")
  author          User          @relation(fields: [authorId], references: [id])
  content         String
  status          CommentStatus @default(VISIBLE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  definitionReferences DefinitionReference[]

  @@index([debateId])
  @@index([postId])
  @@index([parentCommentId])
  @@index([authorId])
  @@map("comments")
}

model SelectionTarget {
  id           String          @id @default(uuid())
  debateId     String          @map("debate_id")
  debate       Debate          @relation(fields: [debateId], references: [id], onDelete: Cascade)
  sourceType   SelectionSource @map("source_type")
  sourceId     String          @map("source_id")
  selectedText String          @map("selected_text")
  startOffset  Int             @map("start_offset")
  endOffset    Int             @map("end_offset")
  creatorId    String          @map("creator_id")
  creator      User            @relation(fields: [creatorId], references: [id])
  createdAt    DateTime        @default(now()) @map("created_at")
  consensuses  Consensus[]
  definitions  Definition[]
  childDebates Debate[]        @relation("ChildDebateSource")

  @@index([debateId])
  @@index([creatorId])
  @@index([sourceType, sourceId])
  @@map("selection_targets")
}

model Consensus {
  id                String          @id @default(uuid())
  debateId          String          @map("debate_id")
  debate            Debate          @relation(fields: [debateId], references: [id], onDelete: Cascade)
  selectionTargetId String          @map("selection_target_id")
  selectionTarget   SelectionTarget @relation(fields: [selectionTargetId], references: [id])
  creatorId         String          @map("creator_id")
  creator           User            @relation(fields: [creatorId], references: [id])
  term              String          @default("")
  title             String
  content           String
  status            ConsensusStatus @default(OPEN)
  resultSummary     String?         @map("result_summary")
  approvedAt        DateTime?       @map("approved_at")
  closedAt          DateTime?       @map("closed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  votes             ConsensusVote[]
  definitions       Definition[]

  @@index([debateId])
  @@index([selectionTargetId])
  @@index([creatorId])
  @@map("consensuses")
}

model ConsensusVote {
  id          String    @id @default(uuid())
  consensusId String    @map("consensus_id")
  consensus   Consensus @relation(fields: [consensusId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  voteType    VoteType  @map("vote_type")
  comment     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([consensusId, userId])
  @@index([userId])
  @@map("consensus_votes")
}

model Definition {
  id                String           @id @default(uuid())
  term              String
  content           String
  sourceDebateId    String           @map("source_debate_id")
  sourceDebate      Debate           @relation(fields: [sourceDebateId], references: [id])
  sourceConsensusId String?          @map("source_consensus_id")
  sourceConsensus   Consensus?       @relation(fields: [sourceConsensusId], references: [id])
  selectionTargetId String?          @map("selection_target_id")
  selectionTarget   SelectionTarget? @relation(fields: [selectionTargetId], references: [id])
  scope             DefinitionScope
  status            DefinitionStatus @default(ACTIVE)
  creatorId         String           @map("creator_id")
  creator           User             @relation(fields: [creatorId], references: [id])
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  terms             DefinitionTerm[]
  references        DefinitionReference[]

  @@index([term])
  @@index([sourceDebateId])
  @@index([sourceConsensusId])
  @@index([selectionTargetId])
  @@index([scope])
  @@index([status])
  @@map("definitions")
}

model DefinitionTerm {
  id             String     @id @default(uuid())
  definitionId   String     @map("definition_id")
  definition     Definition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  normalizedTerm String     @map("normalized_term")
  originalTerm   String     @map("original_term")

  @@index([normalizedTerm])
  @@map("definition_terms")
}

model DefinitionReference {
  id            String                  @id @default(uuid())
  debateId      String                  @map("debate_id")
  debate        Debate                  @relation(fields: [debateId], references: [id], onDelete: Cascade)
  postId        String?                 @map("post_id")
  post          Post?                   @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId     String?                 @map("comment_id")
  comment       Comment?                @relation(fields: [commentId], references: [id], onDelete: Cascade)
  definitionId  String                  @map("definition_id")
  definition    Definition              @relation(fields: [definitionId], references: [id])
  selectedText  String                  @map("selected_text")
  startOffset   Int                     @map("start_offset")
  endOffset     Int                     @map("end_offset")
  referenceType DefinitionReferenceType @map("reference_type")
  creatorId     String                  @map("creator_id")
  creator       User                    @relation(fields: [creatorId], references: [id])
  createdAt     DateTime                @default(now()) @map("created_at")

  @@index([debateId])
  @@index([postId])
  @@index([commentId])
  @@index([definitionId])
  @@index([creatorId])
  @@map("definition_references")
}

model ModerationLog {
  id         String               @id @default(uuid())
  debateId   String?              @map("debate_id")
  debate     Debate?              @relation(fields: [debateId], references: [id], onDelete: Cascade)
  targetType ModerationTargetType @map("target_type")
  targetId   String               @map("target_id")
  actionType ModerationActionType @map("action_type")
  actorId    String               @map("actor_id")
  actor      User                 @relation(fields: [actorId], references: [id])
  reason     String?
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([debateId])
  @@index([actorId])
  @@index([targetType, targetId])
  @@map("moderation_logs")
}

model Report {
  id                    String           @id @default(uuid())
  reporterId            String           @map("reporter_id")
  reporter              User             @relation(fields: [reporterId], references: [id])
  targetType            ReportTargetType @map("target_type")
  targetId              String           @map("target_id")
  debateId              String?          @map("debate_id")
  reason                ReportReason
  detail                String?
  targetContentSnapshot String?          @map("target_content_snapshot")
  status                ReportStatus     @default(PENDING)
  handledById           String?          @map("handled_by_id")
  handledBy             User?            @relation("ReportHandler", fields: [handledById], references: [id])
  handledAt             DateTime?        @map("handled_at")
  resolutionNote        String?          @map("resolution_note")
  createdAt             DateTime         @default(now()) @map("created_at")
  resolvedAt            DateTime?        @map("resolved_at")
  sanctions             Sanction[]

  @@unique([reporterId, targetType, targetId])
  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([handledById])
  @@map("reports")
}

model Sanction {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  user         User            @relation("SanctionedUser", fields: [userId], references: [id])
  reportId     String?         @map("report_id")
  report       Report?         @relation(fields: [reportId], references: [id], onDelete: SetNull)
  moderatorId  String          @map("moderator_id")
  moderator    User            @relation("SanctionModerator", fields: [moderatorId], references: [id])
  type         SanctionType
  status       SanctionStatus  @default(ACTIVE)
  reason       String
  startsAt     DateTime        @default(now()) @map("starts_at")
  endsAt       DateTime?       @map("ends_at")
  revokedAt    DateTime?       @map("revoked_at")
  revokeReason String?         @map("revoke_reason")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  acknowledgements SanctionAcknowledgement[]

  @@index([userId, status])
  @@index([reportId])
  @@index([moderatorId])
  @@map("sanctions")
}

model SanctionAcknowledgement {
  id             String    @id @default(uuid())
  sanctionId     String    @map("sanction_id")
  sanction       Sanction  @relation(fields: [sanctionId], references: [id], onDelete: Cascade)
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime  @default(now()) @map("acknowledged_at")

  @@unique([sanctionId, userId])
  @@index([userId])
  @@map("sanction_acknowledgements")
}

model DebateBookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  debateId  String   @map("debate_id")
  debate    Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, debateId])
  @@index([debateId])
  @@map("debate_bookmarks")
}

model DebateSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  debateId  String   @map("debate_id")
  debate    Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, debateId])
  @@index([debateId])
  @@map("debate_subscriptions")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum DebateType {
  FREE
  CONSENSUS
  PROS_CONS
}

enum DebateStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum DebateStance {
  PRO
  CON
  NEUTRAL
}

enum CloseConditionType {
  TIME_LIMIT
  MANUAL
  TARGET_REACHED
}

enum DebateMemberRole {
  CREATOR
  PARTICIPANT
  MODERATOR
}

enum PostStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum SelectionSource {
  POST
  COMMENT
}

enum ConsensusStatus {
  OPEN
  APPROVED
  REJECTED
  CLOSED
}

enum VoteType {
  APPROVE
  REJECT
  COMMENT
}

enum DefinitionScope {
  IN_DEBATE
  GLOBAL_REFERENCE
}

enum DefinitionStatus {
  ACTIVE
  ARCHIVED
}

enum DefinitionReferenceType {
  DEBATE_STANDARD
  GLOBAL_REFERENCE
}

enum ModerationTargetType {
  POST
  COMMENT
  CONSENSUS
  DEBATE
  USER
  REPORT
  SANCTION
}

enum ModerationActionType {
  NONE
  HIDE
  DELETE
  CLOSE
  RESTORE
  REVIEW
  REJECT
  SANCTION
  REVOKE
}

enum ReportTargetType {
  POST
  COMMENT
  CONSENSUS
  DEBATE
  USER
}

enum ReportReason {
  SPAM
  ABUSE
  HATE
  SEXUAL
  VIOLENCE
  MISINFORMATION
  OFF_TOPIC
  ETC
}

enum ReportStatus {
  PENDING
  REVIEWING
  ACTION_TAKEN
  REJECTED
  DUPLICATE
}

enum SanctionType {
  WARNING
  WRITE_RESTRICTION
  DEBATE_CREATE_RESTRICTION
  TEMP_SUSPENSION
  PERMANENT_SUSPENSION
}

enum SanctionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum NotificationType {
  COMMENT_ON_POST
  REPLY_TO_COMMENT
  NEW_POST_IN_DEBATE
  NEW_CONSENSUS_IN_DEBATE
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String           @map("recipient_id")
  recipient   User             @relation("ReceivedNotifications", fields: [recipientId], references: [id])
  actorId     String           @map("actor_id")
  actor       User             @relation("SentNotifications", fields: [actorId], references: [id])
  type        NotificationType
  debateId    String           @map("debate_id")
  debate      Debate           @relation(fields: [debateId], references: [id], onDelete: Cascade)
  referenceId String           @map("reference_id")
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@map("notifications")
}
